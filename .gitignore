# ---------------------------------------------------------------
# .gitignore - haass-weather-travel
# Node.js 24 / Express middleware
# ---------------------------------------------------------------

# Environment secrets - NEVER commit
.env
.env.local
.env.*.local

# Dependency directories
node_modules/
middleware/node_modules/

# Build output
dist/
build/

# Test coverage
coverage/
middleware/coverage/
*.lcov
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS artefacts
.DS_Store
Thumbs.db
Desktop.ini

# Editor artefacts
.vscode/settings.json
.idea/
*.swp
*.swo
*~


# Temporary files
tmp/
temp/
*.tmp

# Render deploy cache
.render-builddir/
