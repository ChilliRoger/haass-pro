# .env.example - haass-weather-travel
# Copy to .env and fill in real values. Never commit .env.
# All variables without defaults are required at startup.

# ---------------------------------------------------------------
# Middleware server
# ---------------------------------------------------------------

# Port the Express server listens on
PORT=3000

# Node environment (development | production | test)
NODE_ENV=development

# ---------------------------------------------------------------
# Webhook authentication (HTTP Basic, constant-time comparison)
# ---------------------------------------------------------------

# Username Freshservice sends in the Basic auth header
WEBHOOK_AUTH_USER=webhook

# Password / shared secret Freshservice sends in the Basic auth header
WEBHOOK_AUTH_PASS=changeme_strong_random_secret

# ---------------------------------------------------------------
# Freshservice API
# ---------------------------------------------------------------

# Your Freshservice subdomain, e.g. "acme" for acme.freshservice.com
FRESHSERVICE_SUBDOMAIN=your_subdomain_here

# API key from Profile Settings (use a dedicated agent account)
FRESHSERVICE_API_KEY=your_api_key_here

# ---------------------------------------------------------------
# Freshservice field key overrides (optional)
# Middleware discovers keys dynamically; use these to pin a key
# if the auto-discovery produces an ambiguous match.
# ---------------------------------------------------------------

# FIELD_KEY_DESTINATION_CITY=destination_city_12345
# FIELD_KEY_TRAVEL_DATE=travel_date_12345
# FIELD_KEY_TRIP_TYPE=trip_type_12345
# FIELD_KEY_BUDGET_RANGE=budget_range_12345
# FIELD_KEY_SPECIAL_NEEDS=special_needs_12345
# FIELD_KEY_NOTES=notes_12345

# ---------------------------------------------------------------
# Open-Meteo (no API key required; free tier)
# ---------------------------------------------------------------

# Timeout for each outbound Open-Meteo HTTP request, in milliseconds
OPEN_METEO_TIMEOUT_MS=8000

# Maximum retries for transient Open-Meteo failures (429, 5xx, timeout)
OPEN_METEO_MAX_RETRIES=3

# ---------------------------------------------------------------
# Rate limiting (middleware self-protection)
# ---------------------------------------------------------------

# Maximum requests accepted per IP per minute from Freshservice
RATE_LIMIT_RPM=60

# ---------------------------------------------------------------
# Logging
# ---------------------------------------------------------------

# Log level: error | warn | info | debug
LOG_LEVEL=info
